@startuml NekoCafe_Main_UseCase
left to right direction
skinparam packageStyle rectangle

actor "顾客" as Customer
actor "店员" as Staff
actor "店长" as Manager
actor "猫咪管家" as Keeper
actor "总部运营" as Admin

rectangle "NekoCafé 智慧餐饮预约平台" {
  usecase "桌位预约与浏览" as UC1
  usecase "菜品点单" as UC2
  usecase "处理订单与调度" as UC3
  usecase "查看门店经营看板" as UC4
  usecase "猫咪健康档案管理" as UC5
  usecase "跨门店数据分析" as UC6
}

Customer --> UC1
Customer --> UC2
Staff --> UC3
Manager --> UC4
Keeper --> UC5
Admin --> UC6
@enduml